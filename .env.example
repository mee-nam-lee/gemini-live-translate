# =============================================================================
# Gemini 인증 모드 (AUTH_MODE) — 아래 두 경우 중 하나를 선택
# =============================================================================
# [Case 1] AUTH_MODE=adc
#   - Cloud Run 배포 프로젝트 == Gemini 모델 사용 프로젝트 일 때
#   - Cloud Run 서비스 계정(로컬: gcloud auth application-default login)의 ADC로 Gemini 호출
#   - 필수: GOOGLE_CLOUD_PROJECT, GOOGLE_CLOUD_LOCATION
#   - 불필요: GEMINI_PROJECT(비우면 GOOGLE_CLOUD_PROJECT 사용), USER_CREDENTIALS_SECRET
#   - 권한: Cloud Run 서비스 계정에 roles/aiplatform.user
#
# [Case 2] AUTH_MODE=secret_manager
#   - Cloud Run 배포 프로젝트 != Gemini 모델 사용 프로젝트 일 때
#   - GOOGLE_CLOUD_PROJECT의 Secret Manager에 저장된 사용자 OAuth 자격증명으로 GEMINI_PROJECT 호출
#   - 필수: GOOGLE_CLOUD_PROJECT, GOOGLE_CLOUD_LOCATION, GEMINI_PROJECT, USER_CREDENTIALS_SECRET
#   - 권한: Cloud Run 서비스 계정에 해당 시크릿의 roles/secretmanager.secretAccessor
#   - 시크릿 로드 실패 시 ADC로 대체하지 않고 오류로 처리
#
# (기타) AUTH_MODE=api_key : Gemini Developer API 키 사용 (GEMINI_API_KEY 필수)
AUTH_MODE=adc

# [Case 1, 2 공통] Cloud Run 배포 프로젝트 (Case 2에서는 Secret Manager 프로젝트이기도 함)
# Note: gemini-3.5-live-translate-preview requires location="global" on Vertex AI / Agent Platform
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# [Case 2 필수] Gemini 모델을 호출할 프로젝트 (Case 1에서는 비워두기)
GEMINI_PROJECT=
# [Case 2 필수] GOOGLE_CLOUD_PROJECT의 Secret Manager에 있는 사용자 OAuth 자격증명 시크릿 ID (Case 1에서는 무시됨)
USER_CREDENTIALS_SECRET=

# [api_key 모드 전용] Gemini API Key
GEMINI_API_KEY=

# Model Configuration
LIVE_TRANSLATE_MODEL=gemini-3.5-live-translate-preview
SUMMARY_MODEL=gemini-3.8-flash

# Session Management Configuration
# Inactivity timeout in seconds (Default: 600s = 10 minutes)
INACTIVITY_TIMEOUT_SECONDS=600

# Login Gate (fixed shared password; leave empty to disable login)
APP_LOGIN_PASSWORD=change-me
# Secret for signing login cookies (any long random string). Keep stable across deploys.
APP_SESSION_SECRET=
# Login session lifetime in hours
APP_SESSION_HOURS=12
